# PostgreSQL Connection URL
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public"

# Auth & Security
JWT_SECRET="generate-a-strong-random-secret"
SESSION_EXPIRY_DAYS="7"

# Default Admin Seed Config
ADMIN_DEFAULT_NAME="Adamas Admin"
ADMIN_DEFAULT_EMAIL="admin@adamastechconsulting.com"
ADMIN_DEFAULT_PASSWORD="YourStrongPasswordHere"

# Base URL
NEXT_PUBLIC_SITE_URL="https://adamastechconsulting.com"

# External Lead Notification (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
LEAD_NOTIFICATION_EMAIL="marketing@adamastech.in"
